{
  "expo": {
    "name": "venty",
    "slug": "venty",
    "scheme": "venty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.venty.app",
      "associatedDomains": ["applinks:venty.app"]
    },
    "android": {
      "package": "com.venty.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "venty.app", "pathPrefix": "/a" },
            { "scheme": "https", "host": "venty.app", "pathPrefix": "/s" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Venty использует фото из галереи для аватара профиля.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ]
  }
}
